# Cloud Run sets PORT itself — this is only used for local runs
PORT=8080

# Postgres connection string. Locally: postgresql://user:pass@localhost:5432/afrotickets
# On Cloud Run with Cloud SQL Auth Proxy sidecar/connector, use the Unix socket form:
# postgresql://user:pass@localhost/afrotickets?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afrotickets

# Set to "require" only if connecting to a public Cloud SQL IP directly
# (not needed when using the Cloud SQL Auth Proxy / Unix socket)
PGSSL=

# Session tokens (login) — sign these with a long random secret in production
JWT_SECRET=change-me-session-secret

# Digital ticket QR tokens — deliberately a *different* secret from JWT_SECRET
# so a leaked ticket QR can never be replayed as a login credential
TICKET_SECRET=change-me-ticket-secret

# HMAC secret shared with your payment provider's webhook config
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# HMAC secret used to sign the offline check-in manifest
MANIFEST_SECRET=change-me-manifest-secret
