# Cloud Run sets PORT itself — this is only used for local runs
PORT=8080

# Postgres connection string. Locally: postgresql://user:pass@localhost:5432/afrotickets
# On Cloud Run with Cloud SQL Auth Proxy sidecar/connector, use the Unix socket form:
# postgresql://user:pass@localhost/afrotickets?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afrotickets

# Set to "require" only if connecting to a public Cloud SQL IP directly
# (not needed when using the Cloud SQL Auth Proxy / Unix socket)
PGSSL=

# Session tokens (login) — sign these with a long random secret in production
JWT_SECRET=change-me-session-secret

# Digital ticket QR tokens — deliberately a *different* secret from JWT_SECRET
# so a leaked ticket QR can never be replayed as a login credential
TICKET_SECRET=change-me-ticket-secret

# HMAC secret shared with your payment provider's webhook config
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# HMAC secret used to sign the offline check-in manifest
MANIFEST_SECRET=change-me-manifest-secret

# AfroGuide (natural-language event search) — optional. Without this set,
# AfroGuide degrades to a plain keyword search over real event data instead
# of failing outright. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# M-Pesa (Safaricom Daraja) — optional. Without ALL of these set, checkout
# with paymentMethod:"mpesa" falls back to the mock provider instead of
# failing outright. Get sandbox credentials at https://developer.safaricom.co.ke
# — use the SANDBOX app's keys for testing, never your production ones here.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public URL Safaricom will POST payment results to — must be reachable from
# the internet, so this only works once deployed (not on plain localhost).
MPESA_CALLBACK_URL=https://your-service-url/api/orders/webhook/mpesa
# A long random string appended to the callback URL path as a shared secret,
# since Daraja callbacks can't carry a custom auth header the way the mock
# provider's HMAC-signed webhook does. Generate with: openssl rand -hex 24
MPESA_CALLBACK_SECRET=

# Stripe — optional. Without BOTH of these set, checkout with
# paymentMethod:"stripe" falls back to the mock provider instead of failing
# outright. Get test-mode keys at https://dashboard.stripe.com/test/apikeys
# — use the TEST keys (sk_test_... / whsec_...) for local/staging.
STRIPE_SECRET_KEY=
# The matching *publishable* key (pk_test_...) — safe to expose to the
# frontend, this is what the browser's Stripe.js uses to collect card details.
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen --forward-to .../api/orders/webhook/stripe`)
# for local testing, or from the Dashboard's webhook endpoint config once deployed.
STRIPE_WEBHOOK_SECRET=

# Email (SendGrid) — optional. Without both set, email notifications are
# logged to the console (and always saved as an in-app notification row)
# instead of actually sending. Get a key at https://app.sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SMS (Africa's Talking) — optional. Set AT_USERNAME=sandbox for testing
# against their sandbox app before going to a production shortcode/username.
# https://africastalking.com
AT_API_KEY=
AT_USERNAME=

# WhatsApp (Meta WhatsApp Business Cloud API) — optional.
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
